---
// Canonical Skills card owner. Inputs: Theme + PageContext and shared prose. This component
// deliberately emits only the existing right-hand card; About owns the shared parent section.
// Each heading and blurb sit outside the native <details name> accordion's label-only control.
// /js/disclosure.js animates the panel and reveals its bottom close button. Without script,
// the native summary switches between the more/less labels and remains the only toggle.
import { prose } from '../../../prose/site.ts';
import { skillParagraphs } from '../../../prose/skills.ts';
import type { Theme } from '../../../themes/types.ts';
import type { PageContext } from '../../types.ts';

interface Props {
  theme: Theme;
  page: PageContext;
}

const { theme, page } = Astro.props;
void theme;
void page;
const title = prose.text('home.skills.title', 'xs');
const more = prose.get('home.disclosure.more', 'xs');
const less = prose.get('home.disclosure.less', 'xs');
const groups = prose.data.home.skills.groups.map((_group, index) => ({
  name: prose.text(`home.skills.groups.${index}.name`, 'xs'),
  summary: prose.get(`home.skills.groups.${index}.summary`, 's'),
  paragraphs: skillParagraphs(index),
}));
---
<div class="double-view-right card-style">
  {title && <h3 class="card-title skills-header">{title}</h3>}
  {groups.map((group) => (
    // `skills-text` keeps each skin's separator and type on the group as a whole.
    <div class="skills-group skills-text">
      {group.name && <h4 class="skills-section-header">{group.name}</h4>}
      {group.summary && <div class="skills-blurb" set:html={group.summary} />}
      <details name="skills">
        <summary class="disclosure-cue">
          {more && <span class="disclosure-more" set:html={more} />}
          {less && <span class="disclosure-native-close" set:html={less} />}
        </summary>
        <div class="disclosure-panel" tabindex="-1">
          {group.paragraphs.length > 0 && (
            <p class="skills-detail"><Fragment set:html={group.paragraphs.join('<br><br>')} /></p>
          )}
          {less && <button type="button" class="disclosure-close" hidden set:html={less} />}
        </div>
      </details>
    </div>
  ))}
</div>
