---
// LexChat, one route per theme: `/lexchat/` and `/<id>/lexchat/`. Its composition is the
// picker-free one (Q4), so these pages carry no dock, trigger or cycler script.
import { compose, routeTheme } from '../../../layouts/compose.ts';
import type { PageContext } from '../../../layouts/types.ts';
import { themeParams } from '../../../themes/paths.ts';

export const getStaticPaths = () => themeParams().map((params) => ({ params }));

const theme = routeTheme(Astro.params.theme);
const page: PageContext = { type: 'lexchat', path: '/lexchat/' };
const composition = await compose(theme, page);
const Layout = composition.layout;
---
<Layout theme={theme} page={page} composition={composition} />
