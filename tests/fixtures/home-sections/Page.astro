---
// Real S1-15 fixture. The test copies this beside a scratch copy of production src and rewrites
// the imports, retaining full html/body/#main-body/header/main/footer ancestry. S1-16 still owns
// carousel production, so the approved project cards here are fixture-only rendered inputs.
import { listingPosts } from '../../../src/build/posts.ts';
import About from '../../../src/layouts/canonical/components/About.astro';
import Contact from '../../../src/layouts/canonical/components/Contact.astro';
import Footer from '../../../src/layouts/canonical/components/Footer.astro';
import Hero from '../../../src/layouts/canonical/components/Hero.astro';
import Jobs from '../../../src/layouts/canonical/components/Jobs.astro';
import Nav from '../../../src/layouts/canonical/components/Nav.astro';
import type { PageContext } from '../../../src/layouts/types.ts';
import { prose } from '../../../src/prose/site.ts';
import { THEMES } from '../../../src/themes/registry.ts';
import { href } from '../../../src/themes/paths.ts';

interface Props {
  themeId: string;
  sectionOrder?: SectionKey[];
}

type SectionKey = 'about' | 'jobs' | 'projects' | 'blog' | 'contact';

const canonicalSectionOrder: SectionKey[] = ['about', 'jobs', 'projects', 'blog', 'contact'];
const { themeId = 'default', sectionOrder = canonicalSectionOrder } = Astro.props;
const theme = THEMES.find((candidate) => candidate.id === themeId)!;
const page: PageContext = { type: 'home', path: '/' };
const posts = listingPosts();
const sized = (field: { s?: unknown }) => typeof field.s === 'string' ? field.s : '';
const sectionIndex = (key: SectionKey) => sectionOrder.indexOf(key);
const sectionNumber = (key: SectionKey) => String(sectionIndex(key) + 1).padStart(2, '0');
const projectLabel = prose.text('home.sections.projects', 'xs');
const blogLabel = prose.text('home.sections.blog', 'xs');
const seeAll = prose.text('home.seeAllPosts', 'xs');
const projects = prose.data.projects.map((_project, index) => ({
  title: prose.text(`projects.${index}.title`, 'xs'),
  description: prose.paragraphs(`projects.${index}.description`, 'l'),
  image: prose.data.projects[index]!.image,
  tech: prose.data.projects[index]!.tech as string[],
}));
---
<!doctype html>
<html
  data-style={theme.id}
  data-typing={theme.kind === 'skin' ? (theme.typing ?? 'letter') : 'letter'}
  data-typing-delete={theme.kind === 'skin' ? (theme.typingDelete ?? 'word') : 'word'}
  data-no-tilt={theme.kind === 'skin' && theme.flags?.tilt === false ? '' : undefined}
  style="--bg:#1d1d1d;--text:#e6f1ff;--primary:#61ffda"
>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/vendor/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="/vendor/boxicons/css/boxicons.min.css">
    <link rel="stylesheet" href="/vendor/aos/aos.css">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/mobile-styles.css">
    <link rel="stylesheet" href="/css/featured-carousel.css">
    <link rel="stylesheet" href="/css/theme-cycler.css">
    <script is:inline defer src="/vendor/gsap/gsap.min.js"></script>
    <script is:inline defer src="/vendor/jquery/jquery.min.js"></script>
    <script is:inline defer src="/vendor/jquery-ui/jquery-ui.min.js"></script>
    <script is:inline defer src="/vendor/aos/aos.js"></script>
    <script is:inline src="/vendor/vanilla-tilt/vanilla-tilt.min.js"></script>
    <script is:inline defer src="/js/fixture-carousel.js"></script>
    <script is:inline defer src="/js/typing-engine.js"></script>
    <script is:inline src="/js/anim-utils.js"></script>
    <script is:inline defer src="/js/nav-behavior.js"></script>
    <script is:inline defer src="/js/fixture-probe.js"></script>
    <script is:inline defer src="/js/script.js"></script>
    <script is:inline defer src="/js/cursor-follow.js"></script>
  </head>
  <body>
    <div id="main-body">
      <Nav theme={theme} page={page} />
      <main>
        <Hero theme={theme} page={page} />
        <About theme={theme} page={page} sectionIndex={sectionIndex('about')} />
        <Jobs theme={theme} page={page} sectionIndex={sectionIndex('jobs')} />

        <div id="project-header-static"></div>
        <section class="project-section-wrapper" data-aos="fade-up" data-aos-easing="ease-in-out" data-aos-once="true">
          <div class="section-header-wrapper" id="project-header-wrapper">
            {projectLabel && <h2 class="section-header" id="project-header"><span class="sec-num">{sectionNumber('projects')}.</span>{projectLabel}</h2>}
            <span class="section-header-spacer" id="project-header-spacer"></span>
          </div>
          <section class="featured-carousel-section" id="featured-carousel">
            <div class="featured-carousel-container">
              <div class="featured-carousel-fade featured-carousel-fade-left"></div>
              <div class="featured-carousel-track" id="featured-track">
                {projects.map((project) => (
                  <div class="fc-card">
                    <div class="fc-card-image"><img src={href(project.image, theme.id)} alt={project.title}></div>
                    <div class="fc-card-body">
                      <h3 class="fc-card-title">{project.title}</h3>
                      <p class="fc-card-desc"><Fragment set:html={project.description.join('<br><br>')} /></p>
                      <div class="fc-card-tech">{project.tech.map((tech) => <span class="pill">{tech}</span>)}</div>
                    </div>
                  </div>
                ))}
              </div>
              <div class="featured-carousel-fade featured-carousel-fade-right"></div>
            </div>
            <div class="featured-carousel-dots" id="featured-dots"></div>
          </section>
        </section>
        <div class="section-spacer"></div>

        <div id="blog-header-static"></div>
        <section class="blog-section-wrapper" data-aos="fade-up" data-aos-easing="ease-in-out" data-aos-once="true">
          <div class="section-header-wrapper" id="blog-header-wrapper">
            {blogLabel && <h2 class="section-header" id="blog-header"><span class="sec-num">{sectionNumber('blog')}.</span>{blogLabel}</h2>}
            <span class="section-header-spacer" id="blog-header-spacer"></span>
          </div>
          <div class="blog-scroll-container">
            <div class="blog-scroll-fade blog-scroll-fade-left"></div>
            <div class="blog-scroll-track" id="blog-scroll-track">
              {posts.map((post) => (
                <a
                  class="blog-card"
                  href={post.meta.publication === 'external' ? post.meta.externalUrl : `/blog/${post.id}/`}
                  target={post.meta.publication === 'external' ? '_blank' : undefined}
                  rel={post.meta.publication === 'external' ? 'noopener noreferrer' : undefined}
                >
                  <h3 class="blog-card-title">{sized(post.meta.title)}</h3>
                  <p class="blog-card-date">{post.meta.date}</p>
                  <p class="blog-card-excerpt">{typeof post.meta.description.l === 'string' ? post.meta.description.l : ''}</p>
                </a>
              ))}
            </div>
            <div class="blog-scroll-fade blog-scroll-fade-right"></div>
          </div>
          {seeAll && <div class="blog-see-all"><a href="/blog/" class="text-link">{seeAll}</a></div>}
        </section>
        <div class="section-spacer"></div>

        <Contact theme={theme} page={page} sectionIndex={sectionIndex('contact')} />
      </main>
      <Footer variants={['desktop', 'mobile']} />
    </div>
  </body>
</html>
