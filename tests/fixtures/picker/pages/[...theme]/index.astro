---
// S1-11 fixture page: a themed route with the picker mounted in a nav, one per theme.
// tests/browser/picker.spec.ts copies this tree into <tmp>/src/pages/ beside a full copy of
// the real src/, so the build exercises the REAL registry, projection, paths, prose and
// components, not a stand-in. Deliberately minimal: no layout, no shell, no page runtime,
// so anything the picker needs has to come from the picker's own files.
import ThemeDock from '../../layouts/canonical/components/ThemeDock.astro';
import ThemePicker from '../../layouts/canonical/components/ThemePicker.astro';
import type { PageContext } from '../../layouts/types.ts';
import { themeHtml } from '../../themes/apply.ts';
import { themeParams } from '../../themes/paths.ts';
import { THEMES } from '../../themes/registry.ts';

export function getStaticPaths() {
  return themeParams().map((params) => ({ params }));
}

const theme = THEMES.find((entry) => entry.id === (Astro.params.theme ?? 'default'))!;
const html = themeHtml(theme);
const page: PageContext = { type: 'home', path: '/' };
---
<html lang="en" {...html.attrs} style={html.style}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>picker fixture: {theme.id}</title>
    <link rel="stylesheet" href="/vendor/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="/css/theme-cycler.css">
    <Fragment set:html={'<!--theme-assets-->'} />
    {html.links.map((link) => <link rel="stylesheet" href={link} data-style-asset="1">)}
  </head>
  <body>
    <Fragment set:html={'<!--picker-mount:nav-->'} />
    <nav>
      <ul class="static-menu"><ThemePicker /></ul>
      <ul class="static-menu-mobile"><ThemePicker icon="fa-solid fa-palette" className="tc-mobile" /></ul>
    </nav>
    <main>
      <h1 id="probe" style="color: var(--text); background: var(--bg)">{theme.id}</h1>
    </main>
    <ThemeDock theme={theme} page={page} />
    <script is:inline defer src="/js/theme-cycler.js"></script>
  </body>
</html>
