---
// S1-11 fixture page: the standalone case (D12). No nav, no canonical DOM, no library,
// only the dock, the shared runtime and a FAB. If the picker needs anything a utility page
// does not have, it fails here. Tail order is the Shell's (D29): dock, scrim, cycler, FAB.
import PickerFab from '../../../layouts/canonical/components/PickerFab.astro';
import ThemeDock from '../../../layouts/canonical/components/ThemeDock.astro';
import type { PageContext } from '../../../layouts/types.ts';
import { themeHtml } from '../../../themes/apply.ts';
import { themeParams } from '../../../themes/paths.ts';
import { THEMES } from '../../../themes/registry.ts';

export function getStaticPaths() {
  return themeParams().map((params) => ({ params }));
}

const theme = THEMES.find((entry) => entry.id === (Astro.params.theme ?? 'default'))!;
const html = themeHtml(theme);
const page: PageContext = { type: 'privacy', path: '/fab/' };
---
<html lang="en" {...html.attrs} style={html.style}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>picker fixture (fab): {theme.id}</title>
    <link rel="stylesheet" href="/vendor/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="/css/theme-cycler.css">
    <Fragment set:html={'<!--theme-assets-->'} />
    {html.links.map((link) => <link rel="stylesheet" href={link} data-style-asset="1">)}
  </head>
  <body>
    <Fragment set:html={'<!--picker-mount:fab-->'} />
    <main>
      <h1 id="probe" style="color: var(--text); background: var(--bg)">{theme.id}</h1>
    </main>
    <ThemeDock theme={theme} page={page} />
    <script is:inline defer src="/js/theme-cycler.js"></script>
    <PickerFab corner="br" />
  </body>
</html>
