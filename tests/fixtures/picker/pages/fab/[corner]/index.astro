---
// S1-11 fixture page: the same standalone case in each of the four corners, so the FAB's
// placement and the dock's anchoring are proven reachable from every one of them. Default
// theme only, because the corner, not the theme, is what varies here.
import type { ComponentProps } from 'astro/types';
import PickerFab from '../../../layouts/canonical/components/PickerFab.astro';
import ThemeDock from '../../../layouts/canonical/components/ThemeDock.astro';
import type { PageContext } from '../../../layouts/types.ts';
import { themeHtml } from '../../../themes/apply.ts';
import { THEMES } from '../../../themes/registry.ts';

// The one corner list. Astro hoists getStaticPaths into its own scope, so it cannot read a
// frontmatter constant (the build fails with "CORNERS is not defined"); the frontmatter takes
// the type from PickerFab's own prop instead of restating the four values.
export function getStaticPaths() {
  return ['br', 'bl', 'tr', 'tl'].map((corner) => ({ params: { corner } }));
}

const corner = Astro.params.corner as ComponentProps<typeof PickerFab>['corner'];
const theme = THEMES.find((entry) => entry.id === 'default')!;
const html = themeHtml(theme);
const page: PageContext = { type: 'notFound', path: `/fab/${corner}/` };
---
<html lang="en" {...html.attrs} style={html.style}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>picker fixture (fab {corner})</title>
    <link rel="stylesheet" href="/vendor/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="/css/theme-cycler.css">
    <Fragment set:html={'<!--theme-assets-->'} />
    {html.links.map((link) => <link rel="stylesheet" href={link} data-style-asset="1">)}
  </head>
  <body>
    <Fragment set:html={'<!--picker-mount:fab-->'} />
    <main>
      <h1 id="probe" style="color: var(--text); background: var(--bg)">{corner}</h1>
    </main>
    <ThemeDock theme={theme} page={page} />
    <script is:inline defer src="/js/theme-cycler.js"></script>
    <PickerFab corner={corner} />
  </body>
</html>
