---
import FeaturedCarousel from '../../../src/layouts/canonical/components/FeaturedCarousel.astro';
import { canonicalStyleExtras } from '../../../src/layouts/canonical/presentation.ts';
import type { PageContext } from '../../../src/layouts/types.ts';
import { declarations, themeHtml } from '../../../src/themes/apply.ts';
import { prose } from '../../../src/prose/site.ts';
import { THEMES } from '../../../src/themes/registry.ts';

interface Props {
  context: 'home' | 'blog';
  themeId: string;
  carousel: boolean;
  initialize: boolean;
}

const { context, themeId, carousel, initialize } = Astro.props;
const theme = THEMES.find((entry) => entry.id === themeId);
if (!theme) throw new Error(`carousel fixture: unknown theme ${themeId}`);

const page: PageContext = {
  type: context,
  path: context === 'home' ? '/' : '/blog/',
  styleExtras: canonicalStyleExtras(theme.id, { carousel }),
};
const html = themeHtml(theme);
const style = html.style + declarations(page.styleExtras ?? {});
const sectionLabel = prose.text('home.sections.projects', 'xs');
const skinCss = theme.kind === 'skin' ? theme.css : undefined;
---
<!DOCTYPE html>
<html lang="en" {...html.attrs} style={style}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Carousel fixture</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/mobile-styles.css">
  <link rel="stylesheet" href="/css/featured-carousel.css">
  {theme.id !== 'default' && <link rel="stylesheet" href="/css/themes/theme-base.css">}
  {skinCss && <link rel="stylesheet" href={skinCss}>}
</head>
<body>
  <div id="main-body">
    {carousel && context === 'home' && (
      <>
        <div id="project-header-static"></div>
        <section class="project-section-wrapper" data-aos="fade-up" data-aos-easing="ease-in-out" data-aos-once="true">
          <div class="section-header-wrapper" id="project-header-wrapper">
            <h2 class="section-header" id="project-header"><span class="sec-num">03.</span>{sectionLabel}</h2>
            <span class="section-header-spacer" id="project-header-spacer"></span>
          </div>
          <FeaturedCarousel theme={theme} page={page} />
        </section>
        <div class="section-spacer"></div>
      </>
    )}
    {carousel && context === 'blog' && (
      <>
        <div class="section-header-wrapper" id="selected-works-header" data-header-intro>
          <h2 class="section-header blog-section-header"><span class="sec-num">01.</span>{sectionLabel}</h2>
          <span class="section-header-spacer"></span>
        </div>
        <FeaturedCarousel theme={theme} page={page} />
        <div class="section-spacer"></div>
      </>
    )}
  </div>

  {initialize && (
    <>
      <script is:inline src="/vendor/vanilla-tilt/vanilla-tilt.min.js"></script>
      <script is:inline src="/js/featured-carousel.js"></script>
      <script is:inline>window.initFeaturedCarousel();</script>
    </>
  )}
</body>
</html>
