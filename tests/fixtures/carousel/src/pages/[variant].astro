---
import Page from '../../Page.astro';

export function getStaticPaths() {
  const variants = [
    { name: 'home', context: 'home', themeId: 'default', carousel: true, initialize: true },
    { name: 'blog', context: 'blog', themeId: 'default', carousel: true, initialize: true },
    { name: 'no-tilt', context: 'home', themeId: 'brutalist', carousel: true, initialize: true },
    { name: 'marquee-home-static', context: 'home', themeId: 'marquee', carousel: true, initialize: false },
    { name: 'doodle-blog-static', context: 'blog', themeId: 'doodle', carousel: true, initialize: false },
    { name: 'marquee-noncarousel', context: 'home', themeId: 'marquee', carousel: false, initialize: false },
    { name: 'doodle-noncarousel', context: 'blog', themeId: 'doodle', carousel: false, initialize: false },
  ] as const;
  return variants.map(({ name, ...props }) => ({ params: { variant: name }, props }));
}

interface Props {
  context: 'home' | 'blog';
  themeId: string;
  carousel: boolean;
  initialize: boolean;
}
const { context, themeId, carousel, initialize } = Astro.props;
---
<Page context={context} themeId={themeId} carousel={carousel} initialize={initialize} />
