---
// S1-08 fixture page. tests/build/content-validation.test.ts copies this into
// <tmp>/src/pages/ beside a full copy of the real src/ tree, so the build exercises the
// REAL prose binding, post reader, checks integration and DraftPill, not a stand-in.
import { postDraftIssues, publishedPostIds, readPostSources } from '../build/posts.ts';
import DraftPill from '../layouts/canonical/components/DraftPill.astro';
import { prose, proseDrafts } from '../prose/site.ts';

const sources = readPostSources();
// The /* SIZE */ marker sits on its own line so case f can rewrite 'l' to 'xs', which makes
// the request an unwritten size (home.about.body is written at l only).
const about = prose.paragraphs('home.about.body', 'l' /* SIZE */);
const bullets = prose.list('jobs.0.bullets', 'l');
const tech = prose.list('projects.0.tech', 'xs');
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{prose.text('meta.home.title', 's')}</title>
  </head>
  <body>
    <h1>{prose.text('home.about.title', 'xs')}</h1>
    <div class="about-text"><Fragment set:html={about.join('<br><br>')} /></div>
    <ul class="bullets">{bullets.map((item) => <li set:html={item} />)}</ul>
    <ul class="tech">{tech.map((item) => <li set:html={item} />)}</ul>
    <ul class="posts">{publishedPostIds(sources).map((id) => <li>{id}</li>)}</ul>
    <DraftPill
      issues={[...proseDrafts, ...postDraftIssues(sources)]}
      draftPosts={sources.filter((source) => source.meta.publication === 'draft').length}
    />
  </body>
</html>
