---
import Page from '../../Page.astro';

export function getStaticPaths() {
  return ['home', 'blog', 'post'].flatMap((kind) => [
    { params: { kind }, props: { kind, themeId: 'default' } },
    {
      params: { kind: `brutalist-${kind}` },
      props: { kind, themeId: 'brutalist' },
    },
  ]);
}

interface Props {
  kind: 'home' | 'blog' | 'post';
  themeId: string;
}

const { kind, themeId } = Astro.props;
---
<Page kind={kind} themeId={themeId} />
