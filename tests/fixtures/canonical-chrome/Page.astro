---
// Real Astro fixture for S1-14 only. The test copies this template beside a scratch copy of
// production src before building, so imports below are rewritten to that owned project.
import Nav from '../../../src/layouts/canonical/components/Nav.astro';
import Socials from '../../../src/layouts/canonical/components/Socials.astro';
import Footer from '../../../src/layouts/canonical/components/Footer.astro';
import { THEMES } from '../../../src/themes/registry.ts';
import type { PageContext } from '../../../src/layouts/types.ts';

interface Props {
  kind: 'home' | 'blog' | 'post';
  themeId?: string;
}

const { kind, themeId = 'default' } = Astro.props;
const theme = THEMES.find((candidate) => candidate.id === themeId)!;
const page: PageContext = {
  type: kind,
  path: kind === 'home' ? '/' : kind === 'blog' ? '/blog/' : '/blog/toolbelt/',
};
---
<!doctype html>
<html
  data-style={theme.id}
  data-typing="letter"
  data-typing-delete="word"
  style="--bg:#112233;--text:#ddeeff;--primary:#aabbcc"
>
  <head>
    <style is:inline>
      @keyframes chrome-fixture-fade {
        from { opacity: 0.2; transform: translateX(7px); }
        to { opacity: 0.8; transform: translateX(0); }
      }
    </style>
    {kind === 'home' && (
      <>
        <script is:inline defer src="/js/typing-engine.js"></script>
        <script is:inline src="/js/anim-utils.js"></script>
        <script is:inline defer src="/js/nav-behavior.js"></script>
        <script is:inline defer src="/js/cursor-follow.js"></script>
      </>
    )}
    {kind === 'blog' && (
      <>
        <script is:inline src="/js/typing-engine.js"></script>
        <script is:inline src="/js/anim-utils.js"></script>
        <script is:inline defer src="/js/nav-behavior.js"></script>
        <script is:inline defer src="/js/cursor-follow.js"></script>
      </>
    )}
    {kind === 'post' && (
      <>
        <script is:inline defer src="/js/nav-behavior.js"></script>
        <script is:inline defer src="/js/cursor-follow.js"></script>
      </>
    )}
  </head>
  <body>
    <div id="main-body" class={kind === 'post' ? 'blog-post-page' : undefined}>
      <Nav theme={theme} page={page} />
      {kind !== 'post' && <Socials theme={theme} mount={kind} />}
      {kind === 'home' && (
        <>
          <Socials theme={theme} mount="contact" />
          <a class="calendly-link" href="#">prose calendar</a>
        </>
      )}
      <h1 id="typing-text"></h1>
      {kind !== 'post' && (
        <div class="section-header-wrapper" data-header-intro>
          <h2 class="section-header" style="opacity: 0.2; transform: translateX(7px)">
            <span class="section-header-child">Header</span>
          </h2>
        </div>
      )}
      <Footer
        variants={kind === 'post' ? ['desktop'] : ['desktop', 'mobile']}
        desktopClass={kind === 'post' ? 'blog-footer' : kind === 'blog' ? 'blog-listing-footer' : undefined}
      />
    </div>
  </body>
</html>
