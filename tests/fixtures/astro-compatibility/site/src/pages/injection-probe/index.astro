---
// Deliberately gives Astro something to inject: a scoped component <style>
// and a processed (bundled, non-inline) <script>.
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Injection probe</title>
  <meta name="probe-head-marker" content="authored-last-head-node">
</head>
<body>
  <h1 id="probe">probe</h1>
  <style>
    #probe { color: rebeccapurple; }
  </style>
  <script>
    // Imports a real dependency so the bundler must emit an external module chunk.
    import VanillaTilt from 'vanilla-tilt';
    document.getElementById('probe')?.setAttribute('data-booted', typeof VanillaTilt);
  </script>
</body>
</html>
